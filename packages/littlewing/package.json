{
	"name": "littlewing",
	"version": "2.3.2",
	"description": "A small typed language for the formulas your users write: safe by construction, exact decimals, inferred inputs, and a step budget.",
	"keywords": [
		"calculator",
		"decimal",
		"expression",
		"formula",
		"interpreter",
		"language",
		"sandbox",
		"spreadsheet",
		"type-inference",
		"type-safe"
	],
	"homepage": "https://github.com/brielov/littlewing#readme",
	"bugs": {
		"url": "https://github.com/brielov/littlewing/issues"
	},
	"license": "MIT",
	"author": "Gabriel Vaquer <brielov@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brielov/littlewing.git",
		"directory": "packages/littlewing"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/brielov"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./std": {
			"types": "./dist/std.d.ts",
			"default": "./dist/std.js"
		},
		"./temporal": {
			"types": "./dist/temporal.d.ts",
			"default": "./dist/temporal.js"
		},
		"./clock": {
			"types": "./dist/clock.d.ts",
			"default": "./dist/clock.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"prepublishOnly": "cp ../../README.md ../../LICENSE .",
		"release": "bumpp --commit --push --tag",
		"test:package": "tsc -p test/consumer && tsc -p test/consumer/tsconfig.native.json && node test/consumer/smoke.mjs"
	},
	"dependencies": {
		"temporal-spec": "^1.0.1"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"bumpp": "^12.3.0",
		"temporal-polyfill": "^1.0.6",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"temporal-polyfill": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"temporal-polyfill": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
