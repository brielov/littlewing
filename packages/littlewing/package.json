{
	"name": "littlewing",
	"version": "2.3.2",
	"description": "A minimal, high-performance multi-type expression language with lexer, parser, and interpreter. Optimized for browsers with type-safe execution.",
	"keywords": [
		"calculator",
		"evaluation",
		"expression",
		"formula",
		"interpreter",
		"language",
		"lexer",
		"math",
		"parser",
		"type-safe"
	],
	"homepage": "https://github.com/brielov/littlewing#readme",
	"bugs": {
		"url": "https://github.com/brielov/littlewing/issues"
	},
	"license": "MIT",
	"author": "Gabriel Vaquer <brielov@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brielov/littlewing.git",
		"directory": "packages/littlewing"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/brielov"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"prepublishOnly": "cp ../../README.md ../../LICENSE .",
		"release": "bumpp --commit --push --tag",
		"test:package": "tsc -p test/consumer && tsc -p test/consumer/tsconfig.native.json && node test/consumer/smoke.mjs"
	},
	"dependencies": {
		"temporal-spec": "^0.3.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"bumpp": "^11.0.1",
		"temporal-polyfill": "^0.3.2",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"temporal-polyfill": ">=0.3.0"
	},
	"peerDependenciesMeta": {
		"temporal-polyfill": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
